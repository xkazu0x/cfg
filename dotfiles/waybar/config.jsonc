{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 28,

  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],

  "modules-center": [
  ],

  "modules-right": [
    "tray",
    // "cpu",
    // "custom/gpu",
    "memory",
    // "disk",
    "network",
    "pulseaudio",
    "niri/language",
    "clock"
  ],

  "niri/workspaces": {
    "format": "{index}"
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 256,
    "separate-outputs": true
  },

  "niri/language": {
    "format": "{}",
    "format-en": "US",
    "format-pt": "BR"
  },

  "tray": {
    "spacing": 10,
    "icon-size": 18
  },

  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "on-click": "foot btop"
  },

  "custom/gpu": {
    "interval": 5,
    "exec": "~/cfg/scripts/gpu_usage.sh",
    "format": "GPU {}%",
    "on-click": "foot nvtop"
  },

  "memory": {
    "interval": 5,
    "format": "MEM {used:0.0f}G/{total:0.0f}G",
    "tooltip-format": "MEM {percentage}%",
    "on-click": "foot btop"
  },

  "disk": {
    "interval": 30,
    "format": "DISK {specific_used:0.0f}G/{specific_total:0.0f}G",
    "unit": "GiB",
    "path": "/",
    "tooltip-format": "{path} ({percentage_used}%) {specific_free:0.0f}G FREE"
  },

  "network": {
    "format-wifi": "ONLINE",
    "format-ethernet": "ONLINE",
    "format-disconnected": "<span color='#404040'>OFFLINE</span>",
    "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
    "tooltip-format-disconnected": "NO CONNECTION",
    "on-click": "foot nmtui"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "<span color='#404040'>MUTED</span>",
    "tooltip-format": "{desc}",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "clock": {
    "interval": 1,
    "format": "{:%Y-%m-%d %T}",
    "tooltip-format": "<span font='Iosevka Nerd Font' size='16pt'>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 4,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "today": "<span color='#000000' background='#e0e0e0'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    }
  }
}
