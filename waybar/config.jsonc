{
  "layer": "top",
  "position": "top",
  "height": 30,

  "modules-left": [
    "niri/workspaces"
  ],

  "modules-center": [
  ],

  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "niri/language",
    "clock"
  ],

  "niri/workspaces": {
    "format": "{index}"
  },

  "niri/language": {
    "format": "{}",
    "format-en": "US",
    "format-pt": "BR"
  },

  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%"
  },

  "memory": {
    "interval": 5,
    "format": "MEM {percentage}%",
    "tooltip-format": "{used:0.1f}/{total:0.1f} GiB"
  },

  "network": {
    "interval": 5,
    "format-wifi": "NET {signalStrength}%",
    "format-ethernet": "NET {bandwidthDownBits}",
    "format-disconnected": "OFFLINE",
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}  via {gwaddr}",
    "tooltip-format-disconnected": "NO CONNECTION"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED",
    "tooltip-format": "{desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "clock": {
    "interval": 1,
    // "format": "{:%a, %b %d %H:%M}",
    "format": "{:%Y-%m-%d %T}",
    "tooltip-format": "<tt><span font='Iosevka Nerd Font' size='16pt'><b>{calendar}</b></span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<b>{}</b>",
        "weekdays": "<b>{}</b>",
        "days": "{}",
        "today": "<b><u>{}</u></b>",
        "weeks": "W{}"
      }
    }
  }
}
