{
  "layer": "top",
  "position": "top",

  "modules-left": [ "niri/workspaces" ],
  "modules-center": [ "clock#date", "clock#time" ],
  "modules-right": [
    "niri/language",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery"
  ],

  //////////////////////////////
  // NOTE: Modules Left

  "niri/workspaces": {
    "format": "{icon}",
  },

  //////////////////////////////
  // NOTE: Modules Center

  "clock#date": {
    "format": "{:%a, %b %d}"
  },

  "clock#time": {
    "format": "{:%H:%M}"
  },

  //////////////////////////////
  // NOTE: Modules Right

  "niri/language": {
    "format": "KB {long}"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL MUTED",
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "WIFI {bandwidthDownBits}",
    "format-ethernet": "ETH {bandwidthDownBits}",
    "format-disconnected": "",
    "tooltip": false,
    "interval": 5,
  },

  "cpu": {
    "format": "CPU {usage:>2}%",
    "interval": 1
  },

  "memory": {
    "format": "RAM {used:0.1f}G/{total:0.1f}G",
    "interval": 30
  }
}
